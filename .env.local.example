# Copy this file to .env.local and fill in the values below. .env.local is gitignored.

# Supabase project (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key for the Saqer assistant (console.anthropic.com). Server-only -- do not add
# a NEXT_PUBLIC_ prefix, or it would be exposed in the browser bundle.
CLAUDE_API=your-anthropic-api-key
